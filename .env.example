# Public URL the server is reachable at (must match exactly what Caddy serves).
BF_ISSUER_URL=https://mcp.your-domain.tld

# Where SQLite stores users / OAuth state / encrypted Boniforce tokens.
BF_DB_PATH=/var/lib/boniforce-mcp/db.sqlite

# Fernet key (generate with `boniforce-mcp genkey`).
BF_ENCRYPTION_KEY=

# RSA private key in PEM (generate with `boniforce-mcp gensigning`).
# Multi-line: wrap in quotes or escape newlines as \n.
BF_OAUTH_SIGNING_KEY=

# Boniforce API base URL.
BF_API_BASE=https://api.boniforce.de

# uvicorn bind. Keep on localhost; Caddy proxies in front.
BF_HOST=127.0.0.1
BF_PORT=8000

# Leave empty to bind OAuth tokens to BF_ISSUER_URL + /mcp as advertised.
# An old arbitrary audience override must be removed before ChatGPT onboarding.
BF_JWT_AUDIENCE=

# Exact single token from the OpenAI submission portal. Empty disables the route.
BF_OPENAI_VERIFICATION_TOKEN=

# Extra origins allowed to POST to /mcp (comma-separated). Defaults already
# include https://claude.ai, https://chatgpt.com and the issuer origin.
# Required for Anthropic Connectors Directory compliance (Origin-header
# validation).
BF_EXTRA_ALLOWED_ORIGINS=

# Extra hostnames to accept in the Host header (comma-separated). Defaults
# include the issuer hostname; loopback/test hosts are allowed only in development.
# Override only when reachable under additional hostnames.
BF_EXTRA_ALLOWED_HOSTS=
